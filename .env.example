# ==============================================================================
# DOCU-VIBE-STUDIO: Variáveis de Ambiente e Chaves de API Gratuitas
# Copie este arquivo para .env e preencha as chaves desejadas.
# ==============================================================================

# LLM Providers (Pelo menos um recomendado para roteirização automática)
# Obtenha grátis em: https://aistudio.google.com/
GEMINI_API_KEY=""

# Obtenha grátis em: https://console.groq.com/
GROQ_API_KEY=""

# Mídia Gratuita de B-Roll (1080p nativo)
# Obtenha grátis em: https://www.pexels.com/api/
PEXELS_API_KEY=""

# Obtenha grátis em: https://pixabay.com/api/docs/
PIXABAY_API_KEY=""

# ComfyUI Local (Opcional - caso queira imagens conceituais FLUX)
COMFYUI_HOST="127.0.0.1"
COMFYUI_PORT="8188"
